{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docfit.local/schemas/content-field-catalog.json",
  "title": "DocFit content field registry consumer schema",
  "type": "object",
  "required": ["schema_version", "registry_id", "registry_version", "status", "open_world", "fields"],
  "properties": {
    "schema_version": {
      "enum": [
        "docfit-content-field-registry/v0.1",
        "docfit-content-field-registry/v0.2"
      ]
    },
    "registry_id": {"const": "docfit.thesis.content_fields"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["development_baseline", "human_accepted", "accepted"]},
    "open_world": {"const": true},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field_id", "label", "meaning", "content_type", "cardinality"],
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "label": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "content_type": {
            "enum": ["text", "rich_text", "section", "image", "table", "formula", "equation", "asset"]
          },
          "cardinality": {"enum": ["one", "many", "optional"]},
          "parent_field_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "language": {"enum": ["zh", "en", "mixed", "und"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
